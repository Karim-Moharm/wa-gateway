PORT=3001
API_KEY=change-this-shared-secret

# Optional: per-client scoped keys when this one gateway serves multiple
# clients. Each scoped key can only touch session ids starting with its
# prefix + "-" (e.g. key "naweb-secret-1" can only use sessions like
# "naweb-clienta", never "gweb-anything"). Comma-separated prefix:key pairs.
# The API_KEY above always works everywhere (master/admin key) - keep it
# private, only scoped keys should be handed to individual client deployments.
SCOPED_API_KEYS=naweb:naweb-secret-key,gweb:gweb-secret-key
